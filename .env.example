# Local CockroachDB from docker-compose.yml
DATABASE_URL=postgresql://root@localhost:26257/memoryvault?sslmode=disable

# openssl rand -base64 32
AUTH_SECRET=generate-a-long-random-string

# Google Cloud Console -> Credentials -> OAuth client (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required in production unless deploying on Vercel, which supplies the host
# itself. Without one of the two, the app refuses to boot rather than trust a
# client-supplied Host header for callback and redirect URLs.
AUTH_URL=http://localhost:3000

# Bedrock. Credentials come from the default AWS SDK chain (env vars or
# ~/.aws/credentials); enable Titan Embed and Nova Lite in this region.
AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=amazon.nova-lite-v1:0
# Embedding width is not configurable: it is fixed by the vector(1024) column.

# Optional, min 16 chars. Lets the scheduled cron sweep the embedding outbox
# across all workspaces via `Authorization: Bearer <CRON_SECRET>`. Without it
# that door stays closed and signed-in users can only sweep their own
# workspace. On Vercel, set this and the platform sends it automatically.
CRON_SECRET=
